{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "description": "Generate the qiven-runtime Visual Studio 2022 x64 solution.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022-x64",
      "cacheVariables": { "QIVEN_RUNTIME_BUILD_TESTS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "vs2022-x64-debug", "displayName": "Visual Studio 2022 x64 Debug", "configurePreset": "vs2022-x64", "configuration": "Debug" },
    { "name": "vs2022-x64-release", "displayName": "Visual Studio 2022 x64 Release", "configurePreset": "vs2022-x64", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "vs2022-x64-debug", "displayName": "Visual Studio 2022 x64 Debug tests", "configurePreset": "vs2022-x64", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "vs2022-x64-release", "displayName": "Visual Studio 2022 x64 Release tests", "configurePreset": "vs2022-x64", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
