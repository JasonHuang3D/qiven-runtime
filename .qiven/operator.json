{
  "schema_version": 1,
  "repository_name": "qiven-runtime",
  "default_gate": "local",
  "tasks": {
    "exact-head": {
      "builtin": "exact_head"
    },
    "check-toolchain": {
      "argv": ["{python}", "tools/check_toolchain.py"]
    },
    "format-check": {
      "argv": ["{python}", "tools/format_sources.py", "--check"]
    },
    "format": {
      "argv": ["{python}", "tools/format_sources.py", "--fix"]
    },
    "configure": {
      "argv": ["{python}", "../qiven-workspace/bootstrap/qiven-bootstrap.py", "gate-configure", "--devkit", "../qiven-devkit", "--repo", "qiven-runtime", "--repo-root", ".", "--preset", "vs2022-x64", "--cmake", "{cmake}"]
    },
    "delete-all-branches-but-main": {
      "argv": ["{python}", "tools/delete_all_branches.py"]
    },
    "build-debug": {
      "argv": ["{cmake}", "--build", "--preset", "vs2022-x64-debug", "--parallel"]
    },
    "build-release": {
      "argv": ["{cmake}", "--build", "--preset", "vs2022-x64-release", "--parallel"]
    },
    "test-debug": {
      "argv": ["{ctest}", "--preset", "vs2022-x64-debug"]
    },
    "test-release": {
      "argv": ["{ctest}", "--preset", "vs2022-x64-release"]
    },
    "diff-check": {
      "builtin": "git_diff_check",
      "base": "origin/main"
    },
    "clean-tree": {
      "builtin": "git_clean_tree"
    },
    "apply-patch": {
      "argv": ["{python}", "tools/apply_patch.py"]
    },
    "deploy": {
      "argv": ["cmd", "/c", "call tools\\deploy.cmd"]
    },
    "third-party-verify": {
      "argv": ["python", "tools/third_party_verify.py"]
    },
    "h1-kit": {
      "argv": ["python", "tools/h1_kit.py"]
    },
    "h1-kit-test": {
      "argv": ["python", "tools/h1_kit_test.py"]
    },
    "h1-sim": {
      "argv": ["python", "tools/h1_sim_gate.py", "run"]
    }
  },
  "gates": {
    "local": [
      "check-toolchain",
      "third-party-verify",
      "format-check",
      "configure",
      ["build-debug", "build-release"],
      ["test-debug", "test-release"],
      "h1-sim",
      "h1-kit-test",
      "diff-check",
      "clean-tree"
    ]
  },
  "ci": {
    "full": {
      "workflow": "ci.yml",
      "inputs": {
        "jobs": "full"
      }
    }
  }
}
